generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  googleId  String?  @unique
  name      String
  email     String   @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders         Sender[]
  emails          Email[]
  slackConnection SlackConnection?
}

model Sender {
  id               String   @id @default(cuid())
  userId           String
  email            String
  etherealUser     String?
  etherealPassword String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@unique([userId, email])
  @@index([userId])
}

model Email {
  id             String      @id @default(cuid())
  userId         String
  senderId       String
  recipient      String
  subject        String
  body           String
  scheduledAt    DateTime
  sentAt         DateTime?
  status         EmailStatus @default(SCHEDULED)
  bullJobId      String?     @unique
  idempotencyKey String      @unique
  messageId      String?
  attempts       Int         @default(0)
  errorMessage   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender      Sender           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachments EmailAttachment[]

  @@index([userId])
  @@index([senderId])
  @@index([status])
  @@index([scheduledAt])
  @@index([recipient])
}

model EmailAttachment {
  id          String   @id @default(cuid())
  emailId     String
  filename    String
  contentType String
  size        Int
  path        String
  createdAt   DateTime @default(now())

  email Email @relation(
    fields: [emailId],
    references: [id],
    onDelete: Cascade
  )

  @@index([emailId])
}

model SlackConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  accessToken String
  teamId      String?
  channelId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}